<?xml version="1.0" encoding="UTF-8"?>
<opml version="1.0">
  <head>
    <title>TRDB feeds (Inoreader import ready)</title>
  </head>
  <body>

    <!-- ===================================================================
         TRDB_시황 : 기존 8개 (Inoreader 원본)
         · carbaid 오타 → carbide 로 수정
         · Sumitomo 꼬리 AND "" 제거 후 단독 분리
         · 한글 쿼리 2개 로케일 en-US → ko/KR 로 교정
         로케일·when: 파라미터는 trdb.py 의 normalize_google_feed() 가
         재작성하므로, Inoreader 에서 다시 내려받아도 코드가 다시 고칩니다.
         =================================================================== -->
    <outline text="TRDB_시황" title="TRDB_시황">

      <outline type="rss" text="tungsten" title="tungsten"
        xmlUrl="https://news.google.com/rss/search?q=tungsten&amp;hl=en-US&amp;gl=US&amp;ceid=US:en"/>
      <outline type="rss" text="tungsten recycling" title="tungsten recycling"
        xmlUrl="https://news.google.com/rss/search?q=tungsten%20recycling&amp;hl=en-US&amp;gl=US&amp;ceid=US:en"/>
      <outline type="rss" text="tungsten apt" title="tungsten apt"
        xmlUrl="https://news.google.com/rss/search?q=tungsten%20apt&amp;hl=en-US&amp;gl=US&amp;ceid=US:en"/>
      <!-- 수정: carbaid → carbide -->
      <outline type="rss" text="tungsten carbide" title="tungsten carbide"
        xmlUrl="https://news.google.com/rss/search?q=tungsten%20carbide&amp;hl=en-US&amp;gl=US&amp;ceid=US:en"/>
      <outline type="rss" text="tungsten AND Mitsubishi" title="tungsten AND Mitsubishi"
        xmlUrl="https://news.google.com/rss/search?q=%22tungsten%22%20AND%20%22Mitsubishi%22&amp;hl=en-US&amp;gl=US&amp;ceid=US:en"/>
      <!-- 수정: 깨진 복합쿼리를 Sumitomo 단독으로 분리 -->
      <outline type="rss" text="tungsten AND Sumitomo" title="tungsten AND Sumitomo"
        xmlUrl="https://news.google.com/rss/search?q=%22tungsten%22%20AND%20%22Sumitomo%22&amp;hl=en-US&amp;gl=US&amp;ceid=US:en"/>
      <outline type="rss" text="tungsten AND xiamen" title="tungsten AND xiamen"
        xmlUrl="https://news.google.com/rss/search?q=%22tungsten%22%20AND%20%22xiamen%22&amp;hl=en-US&amp;gl=US&amp;ceid=US:en"/>
      <!-- 수정: 한글 쿼리 로케일 -->
      <outline type="rss" text="텅스텐" title="텅스텐"
        xmlUrl="https://news.google.com/rss/search?q=%ED%85%85%EC%8A%A4%ED%85%90&amp;hl=ko&amp;gl=KR&amp;ceid=KR:ko"/>
      <outline type="rss" text="텅스텐 재활용" title="텅스텐 재활용"
        xmlUrl="https://news.google.com/rss/search?q=%ED%85%85%EC%8A%A4%ED%85%90%20%EC%9E%AC%ED%99%9C%EC%9A%A9&amp;hl=ko&amp;gl=KR&amp;ceid=KR:ko"/>

    </outline>

